{
  "expo": {
    "name": "Carfolio",
    "slug": "carfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "carfolio",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carfolio.app"
    },
    "android": {
      "package": "com.carfolio.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Orbit/carfolio"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "sdkVersion": "57.0.0",
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    }
  }
}